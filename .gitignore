# --- ReefScanner ---------------------------------------------------------
# Frontend toolchain
node_modules/
frontend/.vite/

# The built React app. Generated by `npm run build` in app/frontend/ and copied
# into the Python package, from where the wheel picks it up. Build output is
# not committed: it goes stale against the source and bloats diffs. The
# desktop shell prints a clear "run npm run build" message if it's missing.
app/src/reefscanner/app/static/

# Browser automation scratch
.playwright-mcp/

# The Python build-artifact rule `lib/` above would otherwise swallow the
# frontend's API layer, which is source, not build output.
!frontend/src/lib/
!frontend/src/lib/**

# Real footage and results must never be committed — they're large, private,
# and belong next to the dives, not in git. ReefScanner defaults a project's
# output to "<footage folder>_results", so ignore that shape anywhere.
*_results/
inputs/
inputs_results/
outputs/
.DS_Store

# Alembic autogenerate scratch database (see app/alembic.ini)
app/migrations-dev.db
